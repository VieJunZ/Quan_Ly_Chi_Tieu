<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_medium_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="horizontal"
    android:padding="14dp"
    android:baselineAligned="false">

    <!-- CỘT TRÁI: Thú cưng Mochi & Chuỗi ngày Streak -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/pet_medium_emoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🐱"
            android:textSize="36sp" />

        <TextView
            android:id="@+id/tv_streak_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="#33FFAA00"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="🔥 5 ngày"
            android:textColor="#FFAA00"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Đường kẻ ngăn cách mờ -->
    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="#33FFFFFF" />

    <!-- CỘT PHẢI: Ngân sách hôm nay & 3 Nút bấm thao tác nhanh -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2.2"
        android:layout_marginStart="12dp"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hôm nay còn được tiêu"
            android:textColor="#A08EB9"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tv_medium_remaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="150.000 đ"
            android:textColor="#38EF7D"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- 3 Nút bấm nhanh 1 chạm: Nói, Chụp bill, Ghi nhanh -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btn_action_voice"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="#22FFFFFF"
                android:gravity="center"
                android:text="🎙️ Nói"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btn_action_scan"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="#22FFFFFF"
                android:gravity="center"
                android:text="📸 Bill"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btn_action_add"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:background="@drawable/widget_button_bg"
                android:gravity="center"
                android:text="✍️ Ghi"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
