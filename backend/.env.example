# =========================================================================
#  FILE MẪU CẤU HÌNH BACKEND CHO MÁY CHỦ CLOUD (RENDER / VPS)
# =========================================================================

# Cổng máy chủ
PORT=8080
NODE_ENV=production

# Khóa bảo mật JWT (tối thiểu 32 ký tự)
JWT_SECRET=thuchi_jwt_secret_key_cnpm_2026_super_secure_token

# =========================================================================
#  CẤU HÌNH KẾT NỐI CƠ SỞ DỮ LIỆU CLOUD (SQL SERVER)
# =========================================================================

# --- CÁCH 1: Nếu dùng Somee.com (Miễn phí 100%, không cần thẻ Visa) ---
DB_SERVER=your_db_name.mssql.somee.com
DB_NAME=your_db_name
DB_USER=your_somee_username
DB_PASS=your_somee_password
DB_PORT=1433
DB_ENCRYPT=false

# --- CÁCH 2: Nếu dùng Microsoft Azure SQL Database ---
# DB_SERVER=your-sql-server.database.windows.net
# DB_NAME=so_chi_tri_db
# DB_USER=azure_admin
# DB_PASS=azure_password
